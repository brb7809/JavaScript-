// ==UserScript==
// @name         Automatización Facturación - Booking Gross
// @namespace    http://tampermonkey.net/
// @version      1.4
// @description  Automatización de ingreso de datos desde Excel (Nuevas columnas y fórmulas)
// @author       Tu Nombre
// @match        *://*.miweb.com/SWAppWeb/pages/ifds/gross/manualgross/bom_bo_act_search.xhtml*
// @match        *://*.miweb.com/SWAppWeb/pages/ifds/gross/manualgross/bom_bo_gross_details.xhtml*
// @match        *://*.miweb.com/SWAppWeb/pages/ifds/gross/bodeduction/bom_bo_deduction_detail.xhtml*
// @require      https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// ==/UserScript==

(function() {
    'use strict';

    function waitForElement(selector, timeout = 15000) {
        return new Promise((resolve, reject) => {
            if (document.querySelector(selector)) {
                return resolve(document.querySelector(selector));
            }
            const observer = new MutationObserver((mutations) => {
                if (document.querySelector(selector)) {
                    observer.disconnect();
                    resolve(document.querySelector(selector));
                }
            });
            observer.observe(document.body, { childList: true, subtree: true });
            setTimeout(() => {
                observer.disconnect();
                reject(new Error("Timeout esperando el elemento: " + selector));
            }, timeout);
        });
    }

    function createUI() {
        if(document.getElementById('tm-automation-panel')) return;
        
        GM_addStyle(`
            #tm-automation-panel { position: fixed; top: 10px; right: 10px; z-index: 999999; background: #2c3e50; color: white; padding: 15px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); font-family: sans-serif; font-size: 14px; width: 300px; }
            #tm-automation-panel h3 { margin: 0 0 10px 0; font-size: 16px; border-bottom: 1px solid #4ca1af; padding-bottom: 5px; }
            #tm-automation-panel input[type="file"] { margin-bottom: 10px; width: 100%; }
            #tm-automation-panel button { background: #27ae60; color: white; border: none; padding: 8px 12px; cursor: pointer; border-radius: 4px; width: 100%; margin-bottom: 5px;}
            #tm-automation-panel button:hover { background: #2ecc71; }
            #tm-automation-panel button.stop-btn { background: #c0392b; }
            #tm-automation-panel button.stop-btn:hover { background: #e74c3c; }
            #tm-status { margin-top: 10px; font-size: 12px; color: #f1c40f; }
        `);

        let panel = document.createElement('div');
        panel.id = 'tm-automation-panel';
        panel.innerHTML = `
            <h3>Bot de Facturación</h3>
            <input type="file" id="tm-excel-upload" accept=".xlsx, .xls">
            <button id="tm-start-btn">Iniciar Proceso</button>
            <button id="tm-stop-btn" class="stop-btn">Detener y Descargar</button>
            <div id="tm-status">Esperando archivo...</div>
        `;
        document.body.appendChild(panel);

        document.getElementById('tm-start-btn').addEventListener('click', handleFileUpload);
        document.getElementById('tm-stop-btn').addEventListener('click', stopAndDownload);
    }

    function handleFileUpload() {
        let fileInput = document.getElementById('tm-excel-upload');
        if (!fileInput.files.length) {
            alert("Por favor selecciona un archivo Excel primero.");
            return;
        }

        let file = fileInput.files[0];
        let reader = new FileReader();
        reader.onload = function(e) {
            let data = new Uint8Array(e.target.result);
            let workbook = XLSX.read(data, {type: 'array'});
            let firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            let excelData = XLSX.utils.sheet_to_json(firstSheet, {header: 1, raw: false});
            
            // Inyectar nuevos encabezados en la fila 0
            excelData[0][9] = "Output";             // J
            excelData[0][10] = "Script Adm";        // K
            excelData[0][11] = "Script Gross";      // L
            excelData[0][12] = "Diferencia Adm";    // M
            excelData[0][13] = "Diferencia Gross";  // N

            GM_setValue('excelData', excelData);
            GM_setValue('currentRow', 1); 
            GM_setValue('isRunning', true);
            GM_setValue('step', 1);
            
            runProcess();
        };
        reader.readAsArrayBuffer(file);
    }

    function logResult(status, adm = "", gross = "") {
        let data = GM_getValue('excelData');
        let rowIdx = GM_getValue('currentRow');
        let rowNum = rowIdx + 1; // Fila real en Excel (1-based)
        
        data[rowIdx][9] = status; // J: Output

        if(adm !== "") {
            data[rowIdx][10] = adm; // K: Script Adm
            // M: Diferencia Adm (Formula K - F)
            data[rowIdx][12] = { t: 'n', f: `K${rowNum}-F${rowNum}` }; 
        }
        
        if(gross !== "") {
            data[rowIdx][11] = gross; // L: Script Gross
            // N: Diferencia Gross (Formula L - H)
            data[rowIdx][13] = { t: 'n', f: `L${rowNum}-H${rowNum}` }; 
        }

        GM_setValue('excelData', data);
    }

    function stopAndDownload() {
        GM_setValue('isRunning', false);
        let data = GM_getValue('excelData');
        if(!data) return alert("No hay datos en memoria para descargar.");
        
        let ws = XLSX.utils.aoa_to_sheet(data);
        let wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Resultados");
        XLSX.writeFile(wb, "Facturacion_Completada.xlsx");
        document.getElementById('tm-status').innerText = "Proceso detenido. Archivo descargado.";
    }

    async function runProcess() {
        if (!GM_getValue('isRunning', false)) {
            createUI();
            return;
        }

        createUI();
        let data = GM_getValue('excelData');
        let rowIdx = GM_getValue('currentRow');
        let step = GM_getValue('step');

        if (rowIdx >= data.length) {
            stopAndDownload();
            return;
        }

        let currentRowData = data[rowIdx];
        if (!currentRowData || currentRowData.length < 5) {
            GM_setValue('currentRow', rowIdx + 1);
            location.reload();
            return;
        }

        let bkgNo = currentRowData[3];      // D
        let playDate = currentRowData[4];   // E
        let adm = currentRowData[5];        // F
        let gross = currentRowData[7];      // H (Cambiado de índice 6 a 7)

        document.getElementById('tm-status').innerText = `Procesando fila ${rowIdx + 1}: BKG ${bkgNo} | Paso ${step}`;

        try {
            if (step === 1) {
                let searchInput = await waitForElement("[id$=':bookingTagId']");
                searchInput.value = bkgNo;
                
                let searchBtn = await waitForElement("[id$=':search']");
                GM_setValue('step', 2);
                searchBtn.click();
                setTimeout(runProcess, 2000); 

            } else if (step === 2) {
                await waitForElement("[id$=':dtTable']");
                let tbody = document.querySelector("[id$=':dtTable_data']") || document.querySelector("[id$=':dtTable'] tbody");
                let rows = tbody.querySelectorAll("tr");
                let actionResult = "no hay fecha";
                
                let dateParts = String(playDate).split('/');
                let formattedPlayDate = playDate;
                if (dateParts.length === 3) {
                    let month = dateParts[0].padStart(2, '0');
                    let day = dateParts[1].padStart(2, '0');
                    let year = dateParts[2].length === 2 ? "20" + dateParts[2] : dateParts[2];
                    formattedPlayDate = `${month}/${day}/${year}`;
                }
                
                for(let i = 0; i < rows.length; i++) {
                    let cols = rows[i].querySelectorAll("td");
                    if(cols.length >= 19) {
                        let dateText = cols[13].innerText.trim();
                        
                        if(dateText === formattedPlayDate) {
                            let admVal = cols[15].innerText.trim();
                            let grossVal = cols[18].innerText.trim();
                            
                            if (admVal !== "0" || (grossVal !== "0.00" && grossVal !== "0")) {
                                actionResult = "ya estaba digitado";
                            } else {
                                let checkbox = rows[i].querySelector("input[type='checkbox']") || rows[i].querySelector(".ui-chkbox-box");
                                if(checkbox) checkbox.click();
                                actionResult = "ok";
                            }
                            break;
                        }
                    }
                }

                if (actionResult === "ok") {
                    await new Promise(r => setTimeout(r, 1500)); 
                    
                    let continueBtn = await waitForElement("[id$=':continueBOMDetailAction']");
                    GM_setValue('step', 3);
                    continueBtn.click();
                } else {
                    logResult(actionResult); 
                    GM_setValue('step', 5); 
                    runProcess(); 
                }

            } else if (step === 3) {
                let admInput = await waitForElement("input[id$=':weeklyTotal5']");
                let grossInput = await waitForElement("input[id$=':weeklyTotal6']");
                
                admInput.value = adm;
                admInput.dispatchEvent(new Event('change', { bubbles: true }));
                
                grossInput.value = gross;
                grossInput.dispatchEvent(new Event('change', { bubbles: true }));
                
                let saveBtn = await waitForElement("[id$=':saveManualGross']");
                GM_setValue('step', 4);
                saveBtn.click(); 

            } else if (step === 4) {
                let returnBtn = await waitForElement("[id$=':fromGrosses']");
                logResult("Digitado", adm, gross);
                
                GM_setValue('step', 5);
                returnBtn.click(); 

            } else if (step === 5) {
                let clearBtn = await waitForElement("[id$=':clear']");
                
                GM_setValue('currentRow', rowIdx + 1);
                GM_setValue('step', 1);
                
                clearBtn.click();
                
                setTimeout(() => {
                    location.reload(); 
                }, 1500);
            }

        } catch (error) {
            console.error("Error en la automatización:", error);
            logResult("Error: " + error.message);
            
            GM_setValue('step', 1);
            GM_setValue('currentRow', rowIdx + 1);
            window.location.href = window.location.origin + "/SWAppWeb/pages/ifds/gross/manualgross/bom_bo_act_search.xhtml";
        }
    }

    window.addEventListener('load', runProcess);

})();
